# 应用方式（需 repo 成员或有 workflows 权限的账号）:
#   git apply docs/macro-ci-workflow.patch && git commit -am "ci: 接入 macro_data.py 宏观快讯 + verify_quotes.py 推送门禁"
# 内容:
#   1) deploy / wechat / daily 三个 job 各加 macro_data.py 抓取步骤（--json macro_data.json --days 7 --text），
#      失败不阻断（|| echo 降级提示），逐源摘要写入 Step Summary；
#   2) verify_quotes.py 门禁（#43 声称但从未生效的部分）:
#      · deploy（Pages）阶段: || true 不阻断页面部署，verify_report.json 复制进 _site/ 随站点公开，摘要进 Step Summary；
#      · wechat / daily（推送）阶段: 无 || true，FAIL 直接阻断推送（exit 2），摘要仍先写入 Step Summary。
# 说明: Arena Agent 的 GitHub App 缺 workflows 权限，含 .github/workflows/** 的提交会被远端直接 reject，
#       故 workflow 改动以补丁随 PR 交付（同 .github_workflow_new.yml / docs/sentiment-ci-workflow.patch 的历史做法）。

diff --git a/.github/workflows/m.yml b/.github/workflows/m.yml
index 0eef427..0dfc04c 100644
--- a/.github/workflows/m.yml
+++ b/.github/workflows/m.yml
@@ -8,9 +8,11 @@
 #
 # 动态抓取管线 (每次运行均执行, 真正上线 — 行情+社区双动态):
 #   market_data.py      → market_data.json      (Yahoo Finance / Stooq 多源回退抓取最新行情)
+#   verify_quotes.py    → verify_report.json    (推送前全来源数据准确性校验; Pages 阶段不阻断 + 报告随站点公开, 推送阶段 FAIL 直接阻断)
 #   community_data.py   → community_data.json   (14 大社区 HTTP GET + 动态模板回退，每次刷新当天日期)
 #   tools/probe_sentiment_apis.py → docs/sentiment-api-eval.md (量化平台舆情接口实测评分)
 #   sentiment_factors.py → sentiment_data.json (聚宽/米筐/掘金/优矿 + 免费兜底源舆情·新闻因子；境内取不到则 --mock 降级)
+#   macro_data.py       → macro_data.json     (微信 02 栏宏观/财经快讯：Google News RSS + 美联储官方 RSS + 东财检索，只保留 7 天内的条目；抓不到则 02 栏标注未获取，不回填旧文)
 #   build_site.py       → report.html           (把行情+社区+抓取日期注入页面与推送内容)
 #   wechat_push.py --embed                       (把最新推送负载内嵌进 report.html)
 #   wechat_push.py --emit _site/wechat.json
@@ -55,9 +57,21 @@ jobs:
       - name: 🌐 动态抓取行情 (market_data.py → market_data.json)
         run: python3 market_data.py
 
+      - name: 🧪 全来源数据校验 (verify_quotes.py · 报告随站点公开, 不阻断页面部署)
+        run: |
+          python3 verify_quotes.py --data market_data.json --json verify_report.json --text > verify_summary.txt || true
+          if [ -f verify_summary.txt ]; then cat verify_summary.txt; cat verify_summary.txt >> "$GITHUB_STEP_SUMMARY"; fi
+
       - name: 🗣️ 动态抓取社区 (community_data.py → community_data.json · 14 源)
         run: python3 community_data.py
 
+      - name: 📰 动态抓取宏观/财经快讯 (macro_data.py → macro_data.json · 微信 02 栏数据源)
+        run: |
+          timeout 240 python3 macro_data.py --json macro_data.json --days 7 --text > macro_summary.txt 2>&1 \
+            || echo "⚠️ 宏观快讯当次抓取失败：02 栏将显示「今日未获取」，不复用历史文案（推送不因此中断）" > macro_summary.txt
+          cat macro_summary.txt
+          { echo '### 📰 微信 02 栏宏观快讯（仅保留 7 天内、日期可解析的条目）'; echo '```'; cat macro_summary.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
+
       - name: 🔬 舆情接口实测 (tools/probe_sentiment_apis.py → docs/sentiment-api-eval.md)
         run: python3 tools/probe_sentiment_apis.py --mock
 
@@ -90,6 +104,7 @@ jobs:
           mkdir -p _site
           cp report.html _site/index.html
           cp market_data.json _site/market_data.json
+          cp verify_report.json _site/verify_report.json 2>/dev/null || echo "verify_report.json not found, skip"
           cp community_data.json _site/community_data.json || echo "community_data.json not found, skip"
           cp sentiment_data.json _site/sentiment_data.json || echo "sentiment_data.json not found, skip"
           cp -r docs _site/docs 2>/dev/null || echo "docs/ not found, skip"
@@ -128,9 +143,31 @@ jobs:
       - name: 🌐 动态抓取行情 (market_data.py)
         run: python3 market_data.py
 
