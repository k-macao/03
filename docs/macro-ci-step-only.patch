# 应用方式（需 repo 成员或有 workflows 权限的账号 —— Agent 的 GitHub App 缺该权限，
#            含 .github/workflows/** 的提交会被远端直接 reject，已实测确认):
#   git apply docs/macro-ci-step-only.patch && git commit -am "ci: 接入 macro_data.py 宏观快讯抓取步骤"
# 内容: deploy / wechat / daily 三个 job 各加一步 macro_data.py 抓取（--json macro_data.json
#       --days 7 --text），失败不阻断，逐源摘要写入 Step Summary。
# 与 docs/macro-ci-workflow.patch 的区别: 本补丁**只含宏观快讯步骤**，不含 verify_quotes.py 推送门禁
#       （当前 verify_quotes.py 实测 pass 0 / warn 10 / fail 1，直接启用「推送阶段 FAIL 阻断」会掐断每日 09:00 推送）。
# 注: 即使本补丁一直不应用，build_site.py / tools/wechat_push.py 也会在构建期通过
#     macro_data.ensure() 自动补抓，02 栏照样能拿到快讯（本补丁的价值是一手数据源 + 可观测性）。

--- a/.github/workflows/m.yml
+++ b/.github/workflows/m.yml
@@ -9,6 +9,9 @@
 # 动态抓取管线 (每次运行均执行, 真正上线 — 行情+社区双动态):
 #   market_data.py      → market_data.json      (Yahoo Finance / Stooq 多源回退抓取最新行情)
 #   community_data.py   → community_data.json   (14 大社区 HTTP GET + 动态模板回退，每次刷新当天日期)
+#   macro_data.py       → macro_data.json       (网页 02 节 + 微信 02 栏宏观/财经快讯；只保留 7 天内条目，
+#                                                抓不到则标注「今日未获取」，绝不回填历史文案。
+#                                                即使本步骤被删/失败，build_site.py 也会在构建期就地补抓一次)
 #   tools/probe_sentiment_apis.py → docs/sentiment-api-eval.md (量化平台舆情接口实测评分)
 #   sentiment_factors.py → sentiment_data.json (聚宽/米筐/掘金/优矿 + 免费兜底源舆情·新闻因子；境内取不到则 --mock 降级)
 #   build_site.py       → report.html           (把行情+社区+抓取日期注入页面与推送内容)
@@ -58,6 +61,18 @@
       - name: 🗣️ 动态抓取社区 (community_data.py → community_data.json · 14 源)
         run: python3 community_data.py
 
+      - name: 📰 动态抓取宏观/财经快讯 (macro_data.py → macro_data.json · 网页 02 节 + 微信 02 栏数据源)
+        run: |
+          set +e
+          timeout 240 python3 macro_data.py --json macro_data.json --days 7 --text > macro_summary.txt 2>&1
+          rc=$?
+          set -e
+          if [ $rc -ne 0 ] || [ ! -s macro_data.json ]; then
+            echo "⚠️ 宏观快讯当次抓取失败：02 栏将显示「今日未获取」，不复用历史文案（推送不因此中断）" | tee -a macro_summary.txt
+          fi
+          cat macro_summary.txt
+          { echo '### 📰 02 栏宏观快讯（仅保留 7 天内、日期可解析的条目）'; echo '```'; cat macro_summary.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
+
       - name: 🔬 舆情接口实测 (tools/probe_sentiment_apis.py → docs/sentiment-api-eval.md)
         run: python3 tools/probe_sentiment_apis.py --mock
 
